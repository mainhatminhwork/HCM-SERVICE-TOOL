{
  "name": "makino-kho-copy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client"
  },
  "vars": {
    "APP_AUTH_MODE": "email"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "makino-kho-copy-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "makino-kho-copy-images"
    }
  ]
}
